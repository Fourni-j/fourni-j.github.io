{
  "@type": "WebPage",
  "@id": "{{ include.canonical_url }}#webpage",
  "url": "{{ include.canonical_url }}",
  "name": {{ page.title | jsonify }},
  "description": {{ include.meta_description | strip_html | strip_newlines | jsonify }},
  "inLanguage": "en-US",
  "isPartOf": {
    "@id": "{{ '/fridgebuddy/' | absolute_url }}"
  },
  "about": {
    "@id": "{{ '/fridgebuddy/' | absolute_url }}#app"
  }
}{% if page.breadcrumbs %},
{
  "@type": "BreadcrumbList",
  "@id": "{{ include.canonical_url }}#breadcrumbs",
  "itemListElement": [
    {% for crumb in page.breadcrumbs %}{
      "@type": "ListItem",
      "position": {{ forloop.index }},
      "name": {{ crumb.name | jsonify }},
      "item": "{{ crumb.url | absolute_url }}"
    }{% unless forloop.last %},{% endunless %}{% endfor %}
  ]
}{% endif %}
