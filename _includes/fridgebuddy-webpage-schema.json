{% assign fb_home = '/fridgebuddy/' %}{% if page.lang contains 'fr' %}{% assign fb_home = '/fridgebuddy/fr/' %}{% elsif page.lang contains 'de' %}{% assign fb_home = '/fridgebuddy/de/' %}{% endif %}{
  "@type": "WebPage",
  "@id": "{{ include.canonical_url }}#webpage",
  "url": "{{ include.canonical_url }}",
  "name": {{ page.title | jsonify }},
  "description": {{ include.meta_description | strip_html | strip_newlines | jsonify }},
  "inLanguage": "{{ page.lang | default: 'en-US' }}",
  {% if page.date_published %}"datePublished": "{{ page.date_published }}",{% endif %}
  {% if page.date_modified %}"dateModified": "{{ page.date_modified }}",{% endif %}
  "author": {
    "@type": "Person",
    "name": "Charles-Adrien Fournier",
    "url": "{{ '/' | absolute_url }}",
    "jobTitle": "iOS developer",
    "sameAs": [
      "https://github.com/fourni-j",
      "https://www.linkedin.com/in/charlesadrienfournier"
    ]
  },
  "isPartOf": {
    "@id": "{{ fb_home | absolute_url }}"
  },
  "about": {
    "@id": "{{ fb_home | absolute_url }}#app"
  }
}{% if page.breadcrumbs %},
{
  "@type": "BreadcrumbList",
  "@id": "{{ include.canonical_url }}#breadcrumbs",
  "itemListElement": [
    {% for crumb in page.breadcrumbs %}{
      "@type": "ListItem",
      "position": {{ forloop.index }},
      "name": {{ crumb.name | jsonify }},
      "item": "{{ crumb.url | absolute_url }}"
    }{% unless forloop.last %},{% endunless %}{% endfor %}
  ]
}{% endif %}{% if page.faq %},
{
  "@type": "FAQPage",
  "@id": "{{ include.canonical_url }}#faq",
  "mainEntity": [
    {% for item in page.faq %}{
      "@type": "Question",
      "name": {{ item.question | jsonify }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ item.answer | strip_html | jsonify }}
      }
    }{% unless forloop.last %},{% endunless %}{% endfor %}
  ]
}{% endif %}{% if page.competitor_itemlist %},
{% assign comp_key = page.competitor_data | default: 'fridgebuddy_competitors' %}{% assign comp = site.data[comp_key] %}
{
  "@type": "ItemList",
  "@id": "{{ include.canonical_url }}#itemlist",
  "name": {{ page.competitor_itemlist_name | default: "Pantry inventory and food expiration apps compared" | jsonify }},
  "numberOfItems": {{ comp.products | size }},
  "itemListElement": [
    {% for product in comp.products %}{
      "@type": "ListItem",
      "position": {{ forloop.index }},
      "item": {
        "@type": "SoftwareApplication",
        "name": {{ product.name | jsonify }},
        "url": "{{ product.website }}",
        "operatingSystem": {{ product.platforms | jsonify }},
        "description": {{ product.strongest_for | jsonify }}
      }
    }{% unless forloop.last %},{% endunless %}{% endfor %}
  ]
}{% endif %}
